# 네이버 블로그 아이디 (blog.naver.com/<여기>)
NAVER_BLOG_ID=khosungsu0357

# 로그인 세션 저장 경로 (절대 커밋하지 말 것)
NBG_STATE_PATH=.auth/naver.json

# 기본 카테고리 이름 (원고 frontmatter 의 category 가 우선)
NBG_DEFAULT_CATEGORY=

# 1(기본) = 발행 직전까지만 진행하고 멈춤. 실발행은 0
NBG_DRY_RUN=1

# 사람처럼 느리게 (ms). 0 이면 지연 없음
NBG_SLOWMO=120

# (선택) 크로미움 실행 파일을 직접 지정할 때
NBG_CHROMIUM_PATH=
